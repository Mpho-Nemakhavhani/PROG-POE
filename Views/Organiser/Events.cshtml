@model List<ApiEvent>
@{ViewData["Title"]="My events";}
<div class="d-flex justify-content-between mb-3"><h1 class="section-title">My events</h1><a asp-action="CreateEvent" class="btn btn-warning">Create event</a></div>
@if(ViewBag.Error!=null){<div class="alert alert-warning">@ViewBag.Error</div>}<div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Type</th><th>Actions</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.Name</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Location</td><td>@e.EventType</td><td class="d-flex gap-2"><a asp-action="EditEvent" asp-route-id="@e.EventId">Edit</a><a asp-action="Categories" asp-route-id="@e.EventId">Categories</a><a asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a><a asp-action="Results" asp-route-id="@e.EventId">Results</a><form asp-action="DeleteEvent" method="post"><input type="hidden" name="id" value="@e.EventId"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this event?')">Delete</button></form></td></tr>}</tbody></table></div></div>
