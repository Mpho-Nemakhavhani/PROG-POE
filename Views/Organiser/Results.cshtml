@model List<ApiEnrolment>
@{ViewData["Title"]="Capture results";}
<h1 class="section-title">Capture race results</h1><p class="muted">Enter finish times and positions for enrolled participants.</p><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Participant</th><th>Category</th><th>Race no.</th><th>Capture result</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName</td><td>@e.CategoryName</td><td>@e.RaceNumber</td><td><form asp-action="SaveResult" method="post" class="d-flex gap-2 flex-wrap"><input type="hidden" name="EventId" value="@ViewBag.EventId"/><input type="hidden" name="EnrolmentId" value="@e.EnrolmentId"/><input type="time" step="1" name="FinishTime" class="form-control form-control-sm" required/><input type="number" name="Position" min="1" placeholder="Position" class="form-control form-control-sm" required/><input type="hidden" name="Status" value="Finished"/><button class="btn btn-sm btn-dark">Save</button></form></td></tr>}</tbody></table></div></div>
