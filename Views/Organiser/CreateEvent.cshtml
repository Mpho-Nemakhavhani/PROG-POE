@model EventVm
@{ViewData["Title"]="Create event";}<h1 class="section-title">Create an event</h1><div class="card p-4"><form method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="datetime-local" class="form-control"/></div></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="Province" class="form-label"></label><input asp-for="Province" class="form-control"/></div></div><button class="btn btn-warning fw-bold">Save event</button></form></div>