@model List<ApiEvent>
@{ViewData["Title"]="Organiser dashboard";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="section-title">Organiser dashboard</h1><p class="muted">Your events at a glance.</p></div><a asp-action="CreateEvent" class="btn btn-warning fw-bold">＋ Create event</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card p-3"><div class="muted">Your events</div><div class="display-6 fw-bold">@Model.Count</div></div></div><div class="col-md-4"><div class="card p-3"><div class="muted">Upcoming events</div><div class="display-6 fw-bold">@Model.Count(e=>e.EventDate>=DateTime.Now&&e.Status=="Upcoming")</div></div></div><div class="col-md-4"><div class="card p-3"><div class="muted">Next event</div><div class="fw-bold">@Model.Where(e=>e.EventDate>=DateTime.Now).OrderBy(e=>e.EventDate).Select(e=>e.EventDate.ToString("dd MMM")).FirstOrDefault() ?? "—"</div></div></div></div>
@if(ViewBag.Error!=null){<div class="alert alert-warning">@ViewBag.Error</div>}<div class="card"><div class="card-header fw-bold">Your events</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td class="fw-semibold">@e.Name</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Location</td><td>@e.Status</td><td><a asp-action="Categories" asp-route-id="@e.EventId">Manage</a></td></tr>}</tbody></table></div></div>
