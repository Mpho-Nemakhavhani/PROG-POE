@model EventVm
@{ViewData["Title"]="Edit event";}<h1 class="section-title">Edit event</h1><div class="card p-4"><form method="post"><input asp-for="EventId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="datetime-local" class="form-control"/></div></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="Province" class="form-label"></label><input asp-for="Province" class="form-control"/></div></div><div class="mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Upcoming</option><option>Completed</option><option>Cancelled</option></select></div><button class="btn btn-warning">Save changes</button></form></div>