@model List<ApiCategory>
@{ViewData["Title"]="Event categories";var ev=(ApiEvent)ViewBag.Event;}
<h1 class="section-title">@ev.Name · Categories</h1><div class="card p-3 mb-4"><h5>Add category</h5><form asp-action="AddCategory" asp-route-id="@ev.EventId" method="post" class="row g-2"><div class="col-md-3"><input name="Name" class="form-control" placeholder="Category name" required/></div><div class="col-md-2"><input name="DistanceKm" type="number" step=".01" class="form-control" placeholder="Distance km" required/></div><div class="col-md-2"><input name="EntryFee" type="number" step=".01" class="form-control" placeholder="Entry fee"/></div><div class="col-md-2"><input name="MaxParticipants" type="number" class="form-control" placeholder="Capacity" value="100"/></div><div class="col-md-2"><input name="MinAge" type="number" class="form-control" placeholder="Min age" value="0"/></div><div class="col-md-1"><button class="btn btn-warning">Add</button></div></form></div>
<div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Category</th><th>Distance</th><th>Fee</th><th>Capacity</th><th>Min age</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.DistanceKm km</td><td>R @c.EntryFee</td><td>@c.MaxParticipants</td><td>@c.MinAge</td></tr>}</tbody></table></div></div>
