@model ProfileVm
@{ViewData["Title"]="My profile";}
<h1 class="section-title">My profile</h1><div class="card p-4" style="max-width:650px"><div asp-validation-summary="All" class="text-danger"></div><form method="post"><div class="mb-3"><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control"/></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" readonly class="form-control"/></div><div class="mb-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control"/></div><button class="btn btn-warning">Save profile</button></form><div class="alert alert-info mt-3 mb-0">Profile picture upload will be enabled after Azure Blob Storage is configured in the API.</div></div>
