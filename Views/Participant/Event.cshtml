@model ApiEvent
@{ViewData["Title"]=Model.Name;}
<a asp-action="Index" class="text-decoration-none">← All events</a><div class="hero my-3"><span class="badge text-bg-warning">@Model.EventType</span><h1 class="mt-3">@Model.Name</h1><p class="lead">@Model.Description</p><p>📍 @Model.Location, @Model.Province · @Model.EventDate.ToString("dd MMMM yyyy · HH:mm")</p></div><h3 class="section-title">Available categories</h3><div class="row g-3">@foreach(var c in Model.Categories){<div class="col-md-6"><div class="card p-3"><h5>@c.Name</h5><p class="mb-1">@c.DistanceKm km · Minimum age @c.MinAge</p><p>Entry fee: R @c.EntryFee · Capacity: @c.MaxParticipants</p><form asp-action="Enrol" method="post"><input type="hidden" name="CategoryId" value="@c.CategoryId"/><button class="btn btn-warning fw-bold">Enrol in this category</button></form></div></div>}</div>
