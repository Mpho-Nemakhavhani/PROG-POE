@model List<ApiEnrolment>
@{ViewData["Title"]="My enrolments";}
<h1 class="section-title">My enrolments</h1><p class="muted">Your race entries and confirmation status.</p><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Race number</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.CategoryName</td><td>@e.RaceNumber</td><td><span class="status status-@e.Status.ToLower()">@e.Status</span></td></tr>}</tbody></table></div></div>
