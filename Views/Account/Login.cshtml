@model LoginVm
@{ViewData["Title"]="Sign in";}
<div class="row justify-content-center"><div class="col-md-6 col-lg-5"><div class="card"><div class="card-body p-4"><h2 class="section-title">Welcome back</h2><p class="muted">Sign in to your RaceDay account.</p><div asp-validation-summary="All" class="text-danger"></div><form method="post"><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control"/></div><button class="btn btn-dark w-100">Sign in</button></form><p class="mt-3 mb-0">New to RaceDay? <a asp-action="Register">Create an account</a></p></div></div></div></div>
