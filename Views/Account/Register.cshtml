@model RegisterVm
@{ViewData["Title"]="Create account";}
<div class="row justify-content-center"><div class="col-md-7 col-lg-6"><div class="card"><div class="card-body p-4"><h2 class="section-title">Join RaceDay</h2><p class="muted">Create your participant or organiser account.</p><div asp-validation-summary="All" class="text-danger"></div><form method="post"><div class="mb-3"><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control"/></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control"/></div><div class="mb-3"><label asp-for="PhoneNumber" class="form-label">Phone number</label><input asp-for="PhoneNumber" class="form-control"/></div><div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option>Participant</option><option>Organiser</option></select></div><div class="mb-3"><label asp-for="OrganiserCode" class="form-label">Organiser invite code (organisers only)</label><input asp-for="OrganiserCode" class="form-control"/></div><button class="btn btn-warning fw-bold w-100">Create account</button></form></div></div></div></div>
