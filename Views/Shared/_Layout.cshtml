<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head>
<body><nav class="navbar navbar-expand-lg navbar-dark rd-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto">
@if(User.IsInRole("Organiser")){<li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">My Events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent">Create Event</a></li>}
else if(User.IsInRole("Participant")){<li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Index">Discover Events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">My Enrolments</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a></li>}
else{<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a></li>}
</ul><ul class="navbar-nav align-items-lg-center">@if(User.Identity?.IsAuthenticated==true){<li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">@User.Identity.Name</a></li><li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">Sign out</button></form></li>}else{<li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li><li class="nav-item"><a class="btn btn-warning btn-sm fw-semibold" asp-controller="Account" asp-action="Register">Create account</a></li>}</ul></div></div></nav>
<main class="container py-4">@if(TempData["Message"]!=null){<div class="alert alert-info alert-dismissible fade show">@TempData["Message"]<button class="btn-close" data-bs-dismiss="alert"></button></div>}@RenderBody()</main><footer class="container py-4 text-secondary small border-top">© @DateTime.Now.Year RaceDay · Run your race.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
